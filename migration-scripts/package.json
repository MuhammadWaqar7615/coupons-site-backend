{
  "name": "migration-scripts",
  "version": "1.0.0",
  "description": "Migration pipeline from MongoDB Atlas and Cloudinary to PostgreSQL and Supabase Storage",
  "main": "migrate-data.js",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "migrate:media": "node migrate-media.js",
    "migrate:media:dry": "node migrate-media.js --dry-run",
    "migrate:data": "node migrate-data.js",
    "migrate:data:dry": "node migrate-data.js --dry-run",
    "validate": "node validate.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "mongodb": "^6.14.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "prisma": "^6.4.1"
  }
}
