# ==============================================================================
# Environment Configuration for Data & Media Migration
# ==============================================================================

# MongoDB Atlas (Source)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.etu0ai0.mongodb.net/codice_sconto?appName=Cluster0"

# PostgreSQL (Target Database)
# Format: postgresql://USER:PASSWORD@HOST:PORT/tutti_negozi_migration?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tutti_negozi_migration?schema=public"

# Supabase Storage (Target Storage)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Cloudinary (Source Media)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER_PREFIX="codicesconto_stores"
