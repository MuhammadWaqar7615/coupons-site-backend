# ==============================================================================
# CodiceSconto Unified Backend Environment Variables
# ==============================================================================

# Server Port (defaults to 4000 to avoid collision with frontends on 3000)
PORT=4000

# PostgreSQL connection string with PgBouncer pooling (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public&connect_timeout=30"

# PostgreSQL direct connection string (port 5432) for running Prisma migrations
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?schema=public&connect_timeout=30"

# Supabase Storage project URL (used for media upload and storage deletion)
SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Service Role Key (required for server-side storage upload & purge operations)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Supabase Anon Key (public API key)
SUPABASE_ANON_KEY="eyJhbGciOi..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# 64-character hexadecimal secret key used for signing jose HS256 JWT session tokens
SESSION_SECRET="replace-with-a-secure-random-64-character-hex-secret-key"

# Emergency administrator login email override
ADMIN_EMAIL="admin@codicesconto.com"

# Emergency administrator login password override
ADMIN_PASSWORD="super-secure-admin-password"

# Allowed CORS origins for cross-origin frontend communication (comma-separated, optional)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Cookie domain for cross-subdomain authentication (e.g., .codicesconto.com, optional)
COOKIE_DOMAIN=""

# Node environment (development, test, production)
NODE_ENV="development"

# ==============================================================================
# Optional: One-Time ETL / Migration Scripts (in migration-scripts/)
# ==============================================================================
# MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/dbname"
# CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
# CLOUDINARY_API_KEY="your-cloudinary-api-key"
# CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# CLOUDINARY_FOLDER_PREFIX="codicesconto_stores"


